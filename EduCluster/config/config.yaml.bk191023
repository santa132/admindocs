hub:
  revisionHistoryLimit:
  config:
    GenericOAuthenticator:
      client_id: JupyterHub
      client_secret: 0b7602bc12673fca94c70c6611c5e0db67d0339b3a03821f
      oauth_callback_url: http://192.168.33.15/hub/oauth_callback
      authorize_url: http://192.168.33.15:8888/moodle/local/oauth/login.php?client_id=jupyterhub&response_type=code
      token_url: http://192.168.33.15:8888/moodle/local/oauth/token.php
      userdata_url: http://192.168.33.15:8888/moodle/local/oauth/user_info.php
      #userdata_method: "GET"
      scope:
        - user_info
    Authenticator:
      admin_users:
        - admin
    JupyterHub:
      authenticator_class: generic-oauth
  networkPolicy:
    enabled: false

#proxy:
